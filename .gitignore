node_modules
dist
# Build output, not source: the package build scripts copy just-bash's CPython
# wasm here (~10 MB) because its python3 worker resolves ../../../vendor at a
# fixed depth. Regenerated by `npm run build`; shipped via each package's
# `files` field, never committed.
packages/*/vendor/
packages/adapters/*/vendor/
*.log
.DS_Store
.env
.backup
.devtools
.vercel
.claude
.agents
skills-lock.json
.vscode
